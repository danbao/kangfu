.mask {
  position: fixed;
  inset: 0;
  z-index: 800;
  display: flex;
  align-items: flex-end;
  background: rgba(66, 66, 66, 0);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s, background 0.2s;
}
.mask.show {
  opacity: 1;
  pointer-events: auto;
  background: rgba(66, 66, 66, 0.35);
}

.panel {
  width: 100%;
  background: #fff;
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: 30rpx 30rpx calc(30rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.25s ease;
}
.mask.show .panel {
  transform: translateY(0);
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}
.panel-title {
  font-size: 30rpx;
  color: var(--color-text);
  font-weight: 600;
}
.rest-toggle {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: var(--color-grey-bg);
  color: var(--color-text-light);
  font-size: 24rpx;
}
.rest-toggle.on {
  background: var(--color-pink-light);
  color: var(--color-pink-deep);
}
.rest-toggle .dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--color-text-light);
}
.rest-toggle.on .dot {
  background: var(--color-pink-deep);
}

.note-input {
  width: 100%;
  min-height: 160rpx;
  padding: 22rpx;
  box-sizing: border-box;
  background: var(--color-grey-bg);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  color: var(--color-text);
  line-height: 1.55;
}
.ph {
  color: var(--color-text-light);
}
.hint {
  font-size: 22rpx;
  color: var(--color-text-light);
  margin-top: 12rpx;
  padding: 0 6rpx;
}

.panel-foot {
  display: flex;
  gap: 22rpx;
  margin-top: 26rpx;
}
.btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: var(--radius-md);
  font-size: 28rpx;
}
.btn.ghost {
  background: var(--color-grey-bg);
  color: var(--color-text-secondary);
}
.btn.primary {
  background: var(--color-pink);
  color: #fff;
}
