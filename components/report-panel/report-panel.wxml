<view class="mask {{visible ? 'show' : ''}}" bindtap="onClose">
  <view class="wrap" catchtap="noop">
    <view class="card">
      <canvas type="2d" id="reportCanvas" class="canvas"></canvas>
    </view>
    <view class="actions">
      <view class="act" bindtap="onSave">保存到相册</view>
      <view class="act primary" bindtap="onShare">分享图片</view>
    </view>
    <view class="close" catchtap="onClose">关闭</view>
  </view>
</view>
