.mask {
  position: fixed;
  inset: 0;
  z-index: 900;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(66, 66, 66, 0);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s, background 0.2s;
}
.mask.show {
  opacity: 1;
  pointer-events: auto;
  background: rgba(66, 66, 66, 0.5);
}

.wrap {
  width: 660rpx;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  transform: scale(0.92);
  transition: transform 0.25s ease;
}
.mask.show .wrap {
  transform: scale(1);
}

/* 关闭按钮：在 wrap 外，直接响应 mask 的 bindtap */
.top-close {
  color: #fff;
  font-size: 28rpx;
  padding: 16rpx 32rpx;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 40rpx;
  margin-bottom: 20rpx;
  align-self: flex-end;
}

/* 可滚动卡片区 */
.card-scroll {
  flex: 1;
  min-height: 0;
}

/* 删除旧的 close-row / close-btn */

.card {
  width: 100%;
  background: #fff;
  border-radius: var(--radius-lg);
  padding: 16rpx;
  box-sizing: border-box;
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.18);
}
.canvas {
  width: 628rpx;
  height: 1200rpx;
  display: block;
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
  margin-bottom: 8rpx;
  width: 100%;
}
.act {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: var(--radius-md);
  font-size: 28rpx;
  background: rgba(255, 255, 255, 0.92);
  color: var(--color-text-secondary);
}
.act.primary {
  background: var(--color-pink);
  color: #fff;
}

