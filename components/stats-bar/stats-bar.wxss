.stats-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--color-grey-border);
}

.stats-date {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 14rpx;
}

.stats-row {
  display: flex;
  align-items: flex-end;
  gap: 44rpx;
}
.stat {
  display: flex;
  flex-direction: column;
}
.stat-num {
  font-size: 42rpx;
  color: var(--color-pink-deep);
  font-weight: 600;
  line-height: 1.1;
}
.stat-unit {
  font-size: 24rpx;
  color: var(--color-text-light);
  font-weight: 400;
}
.stat-label {
  font-size: 22rpx;
  color: var(--color-text-light);
  margin-top: 6rpx;
}

.stats-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 18rpx;
}
.seg {
  display: flex;
  background: var(--color-grey-bg);
  border-radius: var(--radius-md);
  padding: 4rpx;
}
.seg-item {
  padding: 8rpx 26rpx;
  font-size: 24rpx;
  color: var(--color-text-light);
  border-radius: 12rpx;
}
.seg-item.on {
  background: #fff;
  color: var(--color-pink-deep);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}
.report-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 用 CSS 绘制柱状图图标，柔和浅灰 */
.report-icon {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid var(--color-grey-icon);
  border-radius: 6rpx;
  position: relative;
}
.report-icon::after {
  content: '';
  position: absolute;
  left: 6rpx;
  bottom: 5rpx;
  width: 3rpx;
  height: 10rpx;
  background: var(--color-grey-icon);
  box-shadow: 7rpx -3rpx 0 var(--color-grey-icon), 14rpx -7rpx 0 var(--color-grey-icon);
}
